{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^review-code:(finder|standards|spec|sota|verifier|spec-verifier)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/review-code/scripts/capture.py"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/skills/review-code/scripts/capture.py"]
          }
        ]
      }
    ]
  }
}
